* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  background-color: #030913;
  margin: 0;
  font-family: "Inter", sans-serif;
  overflow-x: hidden;
}

header {
  border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  backdrop-filter: blur(10px);
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: 7vh;
  margin: 0;
  gap: 0;
  position: sticky;
  top: 0;
  background-color: #0309139a;
  z-index: 100;
}

.header-logo {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  max-width: 40px;
  font-family: "Inter", sans-serif;
  font-weight: bold;
  flex-shrink: 1;
  margin-right: 66px;
}

nav {
  display: flex;
  flex-direction: row;
}

ul {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  list-style: none;
}

.menu {
  margin: 0 10px;
  text-align: center;
  font-size: clamp(0.7rem, 1vw, 0.875rem);
  font-family: "Inter", sans-serif;
  font-weight: bold;
}

a {
  text-decoration: none;
  color: #fff;
}

li a {
  transition: color 0.2s ease;
}

li a:hover {
  text-decoration: underline;
  text-underline-offset: 5px;
  text-decoration-thickness: 2px;
  color: #48e;
}

.inicio {
  background-image: url("portada-montana.webp");
  width: 100%;
  max-width: 93vw;
  min-height: 65vh;
  margin-left: 7%;
  padding: 24px;
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  align-items: center;
  gap: 12px;
  font-family: "Inter", sans-serif;
  box-shadow: 0 10px 5px #07142ba8;
  transition: box-shadow 0.2s ease, transform 0.2s ease;

}

.inicio:hover {
  box-shadow: 0 10px 10px #07142b;

  transition: box-shadow 0.3s ease, transform 0.3s ease;
}

h1 {
  color: #fff;
  margin: 0;
  font-family: "Inter", sans-serif;
  font-optical-sizing: auto;
  font-weight: 700;
  font-style: normal;
  width: 100%;
  max-width: 600px;
  text-align: center;
  font-size: clamp(1.8rem, 5vw, 3rem);
  line-height: 1.15;
}

.inicio p {
  color: #fff;
  width: 100%;
  max-width: 420px;
  text-align: center;
  font-size: clamp(0.9rem, 2vw, 1rem);
  line-height: 1.5;
  margin: 0;
}

.Blue {
  color: #008dff;
}

.Button-container {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  align-items: center;
  gap: 8px;
  margin: 0;
  text-align: center;
}

.verservicios {
  background-color: #48e;
  padding: 7px 15px;
  border-radius: 20px;
  font-family: sans-serif;
  font-weight: bold;
  text-align: center;
  margin: 0;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.verservicios:hover {
  transform: translateY(-2.5px);
  box-shadow: 0 8px 24px rgba(255, 255, 255, 0.12);
}

.contactame {
  padding: 7px 15px;
  border-radius: 20px;
  font-family: sans-serif;
  font-weight: bold;
  border: 1px solid #fff;
  text-align: center;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.contactame:hover {
  transform: translateY(-2.5px);
  box-shadow: 0 8px 24px rgba(255, 255, 255, 0.12);
}

.servicios-container {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 24px;
  width: 100%;
  max-width: 1000px;
  margin: 40px auto;
  padding: 0px;
  margin-left: 63px;
  margin-bottom: 100px;
  margin-top: 150px;
}

.servicios-container p {
  margin: 0;
}

.servicios-container h2,
.servicios-container > p {
  grid-column: 1 / -1;
}

.servicios-container h2 {
  color: #fff;
  margin-bottom: -10px;
}

.servicios-container > p {
  color: #94a3b8;
  margin-bottom: 24px;
}

.card-container{
  display: contents;
}


.card {
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  align-items: flex-start;
  width: 100%;
  height: auto;
  min-height: 200px;
  margin: 0;
  padding: 28px 24px;
  background-color: #081525;
  border: 1px solid #172b43;
  border-radius: 16px;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.card h3 {
  margin-bottom: 10px;
  color: #fff;
  font-size: 1rem;
}

.card p {
  color: #94a3b8;
  font-size: 0.85rem;
  line-height: 1.5;
}

.card img {
  margin-bottom: 10px;
}

.card:hover {
  transform: translateY(-6px);
  box-shadow: 0 8px 24px rgba(255, 255, 255, 0.12);
}

.proyector {
  width: 92%;
  max-width: 1000px;
  margin: 40px auto;
  color: #fff;

}

.proyector h2 {
  margin-left: 60px;
}

.proyector > p {
  color: #94a3b8;
  margin-top: 8px;
  margin-left: 60px;

}
.proyecto-1 {
  background-image: url(avatar-felino-alta-fidelidad.webp);
  background-position: center;
  background-size: cover;
}
.proyecto-2 {

}
.proyecto-3 {

}
.carrusel {
  width: 100%;
  height: 360px;
  margin: 30px auto 60px;
  display: flex;
  justify-content: center;
  align-items: center;
}

.carrusel-card {
  position: relative;
  flex: 0 0 30%;
  height: 280px;
  margin: 0;
  padding: 24px;
  display: flex;
  flex-direction: column;
  gap: 12px;
  background-color: #081525;
  border: 1px solid #172b43;
  border-radius: 16px;
  color: #fff;
  cursor: pointer;
  z-index: 1;
  opacity: 0.65;
  filter: brightness(0.55);
  transform: scale(0.9);
  transition:
    flex-basis 0.4s ease,
    transform 0.4s ease,
    margin 0.4s ease,
    opacity 0.4s ease,
    filter 0.4s ease,
    border-color 0.4s ease;
}

.carrusel-card input {
  position: absolute;
  opacity: 0;
}

.carrusel-card h4 {
  font-size: 1.1rem;
}

.carrusel-card p {
  color: #94a3b8;
  font-size: 0.9rem;
  line-height: 1.5;
}

.carrusel:has(.input1:checked) .proyecto-3,
.carrusel:has(.input2:checked) .proyecto-1,
.carrusel:has(.input3:checked) .proyecto-2 {
  order: 1;
  flex-basis: 30%;
  margin: 0;
  z-index: 1;
  transform: scale(0.9);
  opacity: 0.65;
  filter: brightness(0.55);
  border-color: #172b43;
}

.carrusel:has(.input1:checked) .proyecto-1,
.carrusel:has(.input2:checked) .proyecto-2,
.carrusel:has(.input3:checked) .proyecto-3 {
  order: 2;
  flex-basis: 42%;
  margin-left: -5%;
  margin-right: -5%;
  z-index: 2;
  transform: scale(1);
  opacity: 1;
  filter: brightness(1);
  border-color: #008dff;
}

.carrusel:has(.input1:checked) .proyecto-2,
.carrusel:has(.input2:checked) .proyecto-3,
.carrusel:has(.input3:checked) .proyecto-1 {
  order: 3;
  flex-basis: 30%;
  margin: 0;
  z-index: 1;
  transform: scale(0.9);
  opacity: 0.65;
  filter: brightness(0.55);
  border-color: #172b43;
}

.contacto {
  color: #fff;
  display: grid;
  grid-template-columns: repeat(1, 1fr);
  grid-template-rows: auto auto;
  gap: 10px;
  margin-left: 7vw;
  margin-right: 7vw;
}

.div1 {
  grid-column: span 3 / span 3;
  max-height: 100px;
}

.contactos-container {
  display: flex;
  gap: 30px;
  justify-content: space-between;
  align-items: end;
  flex-wrap: nowrap;
}

.correo {
  margin-top: 40px;
  margin-bottom: 20px;
  display: flex;
}

.correo p img {
  max-width: 30px;
  margin: 0;
  padding: 0;
  margin-bottom: -10px;
}

.whatsapp {
  margin-top: 40px;
  margin-bottom: 20px;
  text-wrap: nowrap;
}

.whatsapp p img {
  max-width: 30px;
  margin: 0;
  padding: 0;
  margin-bottom: -10px;
  position: absolute;
}

.ubicacion {
  margin-top: 40px;
  margin-bottom: 20px;
}

.ubicacion p img {
  max-width: 30px;
  margin: 0;
  padding: 0;
  margin-bottom: -10px;
}

@media (max-width: 900px) {
  .servicios-container {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 700px) {

  
  .ubicacion p img {
    transform: translateX(15px) translateY(-10px);
  }
}

@media (max-width: 600px) {
  .proyector h2 {
    margin-left: 0px;
  }

  .proyector > p {
    color: #94a3b8;
    margin-top: 8px;
    margin-left: 0px;
  }

  .servicios-container {
    margin-left: 0;
  }

  .contactos-container {
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    justify-content: center;
  }

  .correo, .whatsapp, .ubicacion {
    font-size: clamp(0.8rem, 3vw, 0.95rem);
    word-break: break-word;
    text-align: center;
  }

  header {
    height: auto;
    min-height: 7vh;
    flex-wrap: wrap;
    justify-content: center;
    padding: 10px;
  }

  nav {
    width: 100%;
    justify-content: center;
  }

  ul {
    justify-content: center;
    gap: 8px;
  }

  .menu {
    margin: 0 4px;
    font-size: 0.75rem;
  }

  .inicio {
    max-width: 100%;
    min-height: 40vh;
    padding: 24px 16px;
    margin-left: 0;
  }

  h1 {
    font-size: clamp(1.7rem, 7vw, 2.3rem);
    max-width: 100%;
  }

  .inicio p {
    max-width: 100%;
    font-size: 0.9rem;
  }

  .Button-container {
    width: 100%;
  }

  .verservicios,
  .contactame {
    padding: 8px 12px;
    font-size: 0.8rem;
  }

  .servicios-container {
    grid-template-columns: 1fr;
    padding: 0 16px;
  }

  .carrusel {
    height: 300px;
  }

  .carrusel-card {
    height: 240px;
    padding: 12px;
  }

  .carrusel:has(.input1:checked) .proyecto-1,
  .carrusel:has(.input2:checked) .proyecto-2,
  .carrusel:has(.input3:checked) .proyecto-3 {
    flex-basis: 50%;
    margin-left: -8%;
    margin-right: -8%;
  }

  .carrusel:has(.input1:checked) .proyecto-3,
  .carrusel:has(.input2:checked) .proyecto-1,
  .carrusel:has(.input3:checked) .proyecto-2,
  .carrusel:has(.input1:checked) .proyecto-2,
  .carrusel:has(.input2:checked) .proyecto-3,
  .carrusel:has(.input3:checked) .proyecto-1 {
    flex-basis: 30%;
  }
}

@media (min-width: 601px) {
  .contactos-container {
    align-items: center;
  }

  .contactos-container .correo,
  .contactos-container .whatsapp,
  .contactos-container .ubicacion {
    display: flex;
    align-items: center;
    margin-top: 40px;
    margin-bottom: 20px;
  }

  .contactos-container p {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    white-space: nowrap;
  }

  .contactos-container p img {
    position: static;
    display: block;
    width: 24px;
    height: 24px;
    max-width: 24px;
    flex: 0 0 24px;
    margin: 0;
    padding: 0;
    transform: none;
    object-fit: contain;
  }
}

@media (max-width: 700px) {
  .contactos-container {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
  }

  .contactos-container .correo,
  .contactos-container .whatsapp,
  .contactos-container .ubicacion {
    display: block;
    margin: 0;
    width: 100%;
  }

  .contactos-container p {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    margin: 0;
    white-space: normal;
  }

  .contactos-container p img {
    position: static;
    display: block;
    width: 24px;
    height: 24px;
    max-width: 24px;
    flex: none;
    margin: 0;
    padding: 0;
    transform: none;
    object-fit: contain;
  }

  .contactos-container .correo p {
    overflow-wrap: anywhere;
  }
}
